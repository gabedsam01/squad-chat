</head>
<body class="body bg" style="margin:0;padding:0;width:100%;background:#f6f6fb;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%">
<div style="display:none;max-height:0;max-width:0;overflow:hidden;mso-hide:all">Approve or deny it in Members. Nothing happens until you answer.&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;&#847;&zwnj;&nbsp;&#8199;&shy;</div>
<div role="article" aria-roledescription="email" aria-label="Someone asks to join your workspace" lang="en" dir="ltr">
<table role="presentation" class="bg" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f6f6fb">
<tr><td align="center" class="px" style="padding:0 24px">
<!--[if mso]><table role="presentation" width="552" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:552px;margin:0 auto">
<tr><td style="padding:32px 0 20px">
<a href="https://x.test" target="_blank" style="display:inline-block;text-decoration:none">
<img class="logo-ink" src="https://x.test/email/logo-ink-tile.png" width="173" height="36" alt="squadchat" style="display:block;border:0;outline:none;width:173px;height:36px;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;font-size:20px;font-weight:600;line-height:36px;color:#12102b">
<!--[if !mso]><!--><img class="logo-bone" src="https://x.test/email/logo-bone.png" width="173" height="36" alt="squadchat" style="display:none;border:0;outline:none;width:173px;height:36px;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;font-size:20px;font-weight:600;line-height:36px;color:#eeecfa"><!--<![endif]-->
</a>
</td></tr>
<tr><td class="card" style="background:#ffffff;border:1px solid #dddde1;border-radius:16px;padding:32px">
<h1 class="h1 ink" style="margin:0 0 16px;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:exactly;font-size:24px;line-height:30px;font-weight:600;letter-spacing:-0.01em;color:#12102b">A request to join <span style="display:inline-block">is waiting</span></h1>
<table width="100%" role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px"><tr>
<td width="44" valign="top" style="width:44px;padding:5px 0 12px"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="avp" width="30" height="30" align="center" valign="middle" style="width:30px;height:30px;border:1px solid #dddde1;border-radius:10px;background:#e9e8f4;color:#2b284d;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:exactly;font-size:13px;line-height:30px;font-weight:700">AS</td></tr></table></td>
<td valign="top" style="padding:0 0 12px">
<p class="ink" style="margin:0;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:exactly;word-break:break-word;font-size:15px;line-height:20px;font-weight:600;color:#12102b">Ana Souza</p><p class="mu" style="margin:0;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:exactly;word-break:break-word;font-size:14px;line-height:20px;color:#535076"><a class="ln-m" href="mailto:ana@estudio.com" style="color:#535076;text-decoration:underline;text-decoration-color:#dddde1;text-underline-offset:3px">ana@estudio.com</a></p></td>
</tr></table>
<p class="tx" style="margin:0 0 16px;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:exactly;word-break:break-word;font-size:16px;line-height:24px;color:#2b284d">They opened <b class="ink" style="font-weight:600;color:#12102b">Alves Studio</b>&#39;s invitation link and asked <span style="display:inline-block">to join.</span></p>
<table width="100%" class="well" role="presentation" cellpadding="0" cellspacing="0" border="0" style="background:#e9e8f4;border-radius:12px;margin:0 0 16px"><tr>
<td class="tx" style="padding:14px 16px;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:exactly;word-break:break-word;font-size:15px;line-height:22px;color:#2b284d">Approve only people you expect. They join as a member unless you pick another role on <span style="display:inline-block">the page.</span></td></tr></table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px"><tr><td><a class="btn" href="https://agentes.chat/org/6f1d2c9a-58c1-4f7e-9d3b-2a7c1e0b9f44/settings/members?request=jr_7&amp;do=approve" target="_blank" style="display:inline-block;background-color:#12102b;border:1px solid #12102b;border-radius:14px;box-shadow:inset 0 1px 0 rgba(255,255,255,.18),inset 0 -1px 0 rgba(0,0,0,.3),0 1px 2px rgba(0,0,0,.18),0 6px 14px -6px rgba(0,0,0,.45);color:#f6f6fb;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:at-least;font-size:15px;line-height:20px;font-weight:600;text-decoration:none;padding:13px 15px;mso-padding-alt:0;text-underline-color:#12102b"><!--[if mso]><i style="mso-font-width:107%;mso-text-raise:187%" hidden>&emsp;</i><![endif]--><span style="mso-text-raise:93%;color:#f6f6fb">Approve</span><!--[if mso]><i style="mso-font-width:107%" hidden>&emsp;&#8203;</i><![endif]--></a><span style="display:inline-block;width:16px;font-size:15px;line-height:20px">&nbsp;&nbsp;&nbsp;&nbsp;</span><a class="ln-d" href="https://agentes.chat/org/6f1d2c9a-58c1-4f7e-9d3b-2a7c1e0b9f44/settings/members?request=jr_7&amp;do=deny" target="_blank" style="display:inline-block;padding:14px 0;color:#b42a20;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:at-least;font-size:15px;line-height:20px;font-weight:600;text-decoration:underline;text-decoration-color:#dddde1;text-underline-offset:3px;text-underline-color:#dddde1"><span style="mso-text-raise:93%">Deny</span></a></td></tr></table>
<p class="mu" style="margin:0 0 2px;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:exactly;font-size:14px;line-height:20px;color:#535076">All waiting requests are <span style="display:inline-block">in Members.</span></p>
</td></tr>
<tr><td style="padding:24px 0 0"><img class="sky" src="https://x.test/email/sky-band.png" width="552" height="27" alt="" style="display:block;border:0;outline:none;width:552px;max-width:100%;height:auto"></td></tr>
<tr><td style="padding:16px 0 40px">
<p class="fa" style="margin:0 0 6px;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:exactly;word-break:break-word;font-size:13px;line-height:19px;color:#635f87">You got this email because you&#39;re an owner or admin of Alves Studio. It goes out at most once <span style="display:inline-block">an hour.</span></p>
<p class="fa" style="margin:0 0 6px;font-family:'Source Sans 3',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,'Hiragino Sans','PingFang SC','Microsoft YaHei','Apple SD Gothic Neo','Malgun Gothic',sans-serif;mso-line-height-rule:exactly;word-break:break-word;font-size:13px;line-height:19px;color:#635f87">Sent by the squadchat server <span style="display:inline-block">at x.test.</span></p>
</td></tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>
</div>
</body>
</html>"
`;

exports[`every email, in both languages join_request.pt-BR: snapshot 1`] = `
"<!doctype html>
<html lang="pt-BR" dir="ltr" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<style>
:root{color-scheme:light dark;supported-color-schemes:light dark}
</style>
<style>
@media (prefers-color-scheme:dark){.bg{background:#0e0c2a!important}.card{background:#1a1940!important;border-color:#3c3a62!important}.ink{color:#eeecfa!important}.tx{color:#c9c6e4!important}.mu{color:#a09dc4!important}.fa{color:#908cb6!important}.well{background:#07061a!important}.wh{border-color:#1c1a31!important}.num{background:#1a1940!important;border-color:#3c3a62!important;color:#a09dc4!important}.btn{background:#eeecfa!important;color:#0e0c2a!important;border-color:#eeecfa!important}.btn span{color:#0e0c2a!important}.ln{color:#eeecfa!important;text-decoration-color:#3c3a62!important}.avp{background:#07061a!important;color:#c9c6e4!important;border-color:#3c3a62!important}.warn{background:#2b2214!important}.warn-t{color:#f0c954!important}.ln-d{color:#ff9a9a!important;text-decoration-color:#3c3a62!important}.ln-m{color:#a09dc4!important;text-decoration-color:#3c3a62!important}.end-btn{margin-bottom:4px!important}.logo-ink{display:none!important}.logo-bone{display:block!important}}
</style>
<style>
[data-ogsc] .bg{background:#0e0c2a!important}[data-ogsb] .bg{background:#0e0c2a!important}
[data-ogsc] .card{background:#1a1940!important;border-color:#3c3a62!important}[data-ogsb] .card{background:#1a1940!important;border-color:#3c3a62!important}
[data-ogsc] .ink{color:#eeecfa!important}[data-ogsb] .ink{color:#eeecfa!important}
[data-ogsc] .tx{color:#c9c6e4!important}[data-ogsb] .tx{color:#c9c6e4!important}
[data-ogsc] .mu{color:#a09dc4!important}[data-ogsb] .mu{color:#a09dc4!important}
[data-ogsc] .fa{color:#908cb6!important}[data-ogsb] .fa{color:#908cb6!important}
[data-ogsc] .well{background:#07061a!important}[data-ogsb] .well{background:#07061a!important}
[data-ogsc] .wh{border-color:#1c1a31!important}[data-ogsb] .wh{border-color:#1c1a31!important}
[data-ogsc] .num{background:#1a1940!important;border-color:#3c3a62!important;color:#a09dc4!important}[data-ogsb] .num{background:#1a1940!important;border-color:#3c3a62!important;color:#a09dc4!important}
[data-ogsc] .btn{background:#eeecfa!important;color:#0e0c2a!important;border-color:#eeecfa!important}[data-ogsb] .btn{background:#eeecfa!important;color:#0e0c2a!important;border-color:#eeecfa!important}
[data-ogsc] .btn span{color:#0e0c2a!important}[data-ogsb] .btn span{color:#0e0c2a!important}
[data-ogsc] .ln{color:#eeecfa!important;text-decoration-color:#3c3a62!important}[data-ogsb] .ln{color:#eeecfa!important;text-decoration-color:#3c3a62!important}
[data-ogsc] .avp{background:#07061a!important;color:#c9c6e4!important;border-color:#3c3a62!important}[data-ogsb] .avp{background:#07061a!important;color:#c9c6e4!important;border-color:#3c3a62!important}
[data-ogsc] .warn{background:#2b2214!important}[data-ogsb] .warn{background:#2b2214!important}
[data-ogsc] .warn-t{color:#f0c954!important}[data-ogsb] .warn-t{color:#f0c954!important}
[data-ogsc] .ln-d{color:#ff9a9a!important;text-decoration-color:#3c3a62!important}[data-ogsb] .ln-d{color:#ff9a9a!important;text-decoration-color:#3c3a62!important}
[data-ogsc] .ln-m{color:#a09dc4!important;text-decoration-color:#3c3a62!important}[data-ogsb] .ln-m{color:#a09dc4!important;text-decoration-color:#3c3a62!important}
[data-ogsc] .end-btn{margin-bottom:4px!important}[data-ogsb] .end-btn{margin-bottom:4px!important}
[data-ogsc] .logo-ink{display:none!important}[data-ogsb] .logo-ink{display:none!important}
[data-ogsc] .logo-bone{display:block!important}[data-ogsb] .logo-bone{display:block!important}
</style>
<style>
@media (prefers-color-scheme:light){.btn{background-image:linear-gradient(180deg,#3b3950 0%,#12102b 100%)!important}}
</style>
<style>
@media (prefers-color-scheme:dark){.btn{background-image:linear-gradient(180deg,#c6c4d5 0%,#eeecfa 100%)!important}}
</style>
<title>Alguém pede para entrar no seu workspace</title>
